# --- Supabase (required for Phase 1) ---
# Project Settings -> API in your Supabase dashboard.
# Service-role key has full DB access: keep it server-side only, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CoinGecko (optional in Phase 1) ---
# Leave empty to use CoinGecko's public, unauthenticated endpoint (rate-limited).
# If you have a Demo API key, set it here to use the higher demo rate limit.
COINGECKO_API_KEY=

# --- Optional: direct Postgres connection, only used by scripts/apply_migration.py ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, use the
# "Session pooler" or direct connection). Not required if you apply migrations manually
# via the Supabase SQL Editor instead.
DATABASE_URL=

# --- App behavior ---
# Minimum minutes between stored market snapshots per asset, to avoid redundant writes.
MIN_SNAPSHOT_INTERVAL_MINUTES=5

# Quote currency for market data.
VS_CURRENCY=usd

LOG_LEVEL=INFO

# --- OpenRouter / LLM research (required only when running with --with-llm) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model slugs. Must be set explicitly — the app will not silently
# fall back to a free model. Verified live against openrouter.ai/api/v1/models
# (re-check https://openrouter.ai/models — slugs/pricing change over time):
# CLAUDE_MODEL=anthropic/claude-sonnet-5
# OPENAI_MODEL=openai/gpt-5
# GEMINI_MODEL=google/gemini-2.5-pro
CLAUDE_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# Hard spend caps for LLM calls. Once exceeded, no further LLM calls are made
# until the window resets; the run continues without them (fails safely).
MAX_DAILY_LLM_COST=5.00
MAX_MONTHLY_LLM_COST=50.00

# --- News collection (used only alongside --with-llm) ---
NEWS_LOOKBACK_HOURS=24
MAX_NEWS_ARTICLES_PER_ASSET=5

# --- Screening / regime classification (used only with --with-screening) ---
# Optional. Free tier: https://coinmarketcap.com/api/. Without a key, this
# source is recorded NOT_IMPLEMENTED in signal_sources — never approximated —
# and the altcoin-season regime input is UNAVAILABLE (it needs CMC's 90d
# percent-change field; CoinGecko doesn't offer a 90d window).
COINMARKETCAP_API_KEY=

# Coinbase/Binance need no key for public market data — nothing to set here.

# 30, not 50: CoinGecko's free-tier per-asset historical endpoint rate-limits
# after ~5 rapid calls, and every other per-asset call adds runtime; a modest
# universe keeps a screening run fast and reliable. Momentum/market-cap/volume
# come from one batched CoinGecko call regardless of this size; volatility/
# drawdown come from Binance (primary) or Coinbase (fallback) per-asset calls,
# both verified to handle 30+ sequential calls with no rate-limiting.
SCREENING_UNIVERSE_SIZE=30

# How many of the screened universe surface as TOP_CANDIDATES per run.
TOP_CANDIDATES_SIZE=10

# --- Derivatives / on-chain evidence (used only with --with-derivatives) ---
# Binance Futures, Deribit, CFTC, and DefiLlama need no key for public data —
# nothing to set here.

# Optional. Free tier: https://etherscan.io/apis. Without a key, this source
# is recorded NOT_IMPLEMENTED — never approximated.
ETHERSCAN_API_KEY=

# Optional. On-chain valuation-cycle metrics (MVRV/SOPR/NUPL/cohorts) and BTC
# miner metrics very likely require Glassnode's PAID tier — this is a real
# recurring-dollar-cost decision, deliberately left unsubscribed for now (see
# README). Without a key, recorded NOT_IMPLEMENTED.
GLASSNODE_API_KEY=

# --- Multi-model current market assessment (Phase 3d, used only with
# --with-assessment) ---
# Requires OPENROUTER_API_KEY (same key as --with-llm) and a prior
# --with-screening run (assesses the latest TOP_CANDIDATES only).
# Optional override of which models to run — defaults to reusing
# CLAUDE_MODEL/OPENAI_MODEL/GEMINI_MODEL, so this stage needs zero new keys
# out of the box. Format: "name:model_slug,name:model_slug,...", e.g.
# OPENROUTER_ASSESSMENT_MODELS=claude:anthropic/claude-sonnet-4.5,openai:openai/gpt-5
# Deliberately Claude/OpenAI/Gemini only for 3d (matches Phase 2's 3 models) —
# xAI/Grok deferred to a later phase once there's a 3-model baseline to
# compare a 4th model against.
OPENROUTER_ASSESSMENT_MODELS=

# Bumped when the assessment prompt's shape or instructions change; stored
# alongside each persisted prompt_templates row for point-in-time provenance.
ASSESSMENT_PROMPT_VERSION=v1

# --- Judge, Risk Engine, Portfolio Construction (Phase 3e, used only with
# --with-judge / --evaluate-outcomes) ---
# Requires OPENROUTER_API_KEY and a prior --with-assessment run (judges the
# latest TOP_CANDIDATES that have a 3d model assessment). A single
# synthesizing model, not an ensemble — defaults to reusing CLAUDE_MODEL.
JUDGE_MODEL=

# Bumped when the Judge prompt's shape or instructions change (currently v2
# — v1's WATCH/NO_TRADE wording was ambiguous and produced zero live
# NO_TRADEs; see README).
JUDGE_PROMPT_VERSION=v2

# Risk Engine hard gates/formulas — conservative starting points for a paper
# system, not backtested-optimal values. See README's Phase 3e section for
# what each one does.
MAX_SINGLE_ASSET_ALLOCATION=0.15
MAX_NEW_POSITION_SIZE=0.05
MAX_WEEKLY_TURNOVER=0.30
MIN_BUY_CONFIDENCE=0.55
MIN_REBALANCE_CONFIDENCE=0.50
MIN_SELL_CONFIDENCE=0.50
MIN_REPLACEMENT_ALPHA_ADVANTAGE=0.03
MAX_CONCURRENT_POSITIONS=8
RISK_TARGET_VOLATILITY=0.03
CORRELATION_FLAG_THRESHOLD=0.7

# --- Adversarial research, macro matrix, remaining fragile sources (Phase 3f) ---
# FRED (Federal Reserve Economic Data). Free signup, no cost:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Used for global liquidity proxies (M2/WALCL/reverse repo) and BTC's rolling
# correlation to equities (S&P 500) / DXY, both sourced from FRED series so
# this stays one vendor relationship. Without a key, GLOBAL_LIQUIDITY_MACRO
# is recorded NOT_IMPLEMENTED — never approximated.
FRED_API_KEY=

# congress.gov API. Free signup, no cost: https://api.congress.gov/sign-up
# Used for the legislative-tracking side of the regulatory/policy event
# calendar (SEC EDGAR's full-text search needs no key at all — just a
# descriptive User-Agent header per SEC's fair-access policy). Without a
# key, the congress.gov side is recorded NOT_IMPLEMENTED.
CONGRESS_GOV_API_KEY=

# xAI API (console.x.ai). PAID — a real per-call cost, verified before any
# live wiring per the 3f feasibility check (see README). Deliberately not
# pursued this round (see README) — PlanB is recorded NOT_IMPLEMENTED.
# Kept here for a future phase if a paid xAI relationship is established.
XAI_API_KEY=

# A descriptive User-Agent identifying the requester, per SEC EDGAR's
# fair-access policy — not a secret, just courtesy. Optional; a sane
# default is already used if unset.
SEC_EDGAR_USER_AGENT=

# Single model for 3f's bull -> bear -> scenario research cycle (unlike 3d's
# independent ensemble) — defaults to reusing CLAUDE_MODEL.
ADVERSARIAL_MODEL=
ADVERSARIAL_PROMPT_VERSION=v1

# --- Judge reasoning audit (Phase 3g task 5, scripts/run_reasoning_audit.py) ---
# Defaults to reusing CLAUDE_MODEL, same pattern as JUDGE_MODEL/ADVERSARIAL_MODEL.
REASONING_AUDIT_MODEL=

# --- Entity-flow intelligence, network/dev fundamentals (Phase 3i, used
# only with --with-asset-intelligence) ---
# Nansen. Free tier: https://app.nansen.ai (100 one-time credits + 10/day
# refill, all endpoints available) -- real but genuinely credit-constrained;
# see README for coverage limits (EVM/Solana chains only, no BTC). Without a
# key, ENTITY_FLOW_INTELLIGENCE is recorded NOT_IMPLEMENTED, never approximated.
NANSEN_API_KEY=

# Optional. A free GitHub personal access token (no scopes needed) raises
# the rate limit for developer-activity commit/contributor lookups from
# 60/hr to 5000/hr -- not required for this project's small, curated repo set.
GITHUB_TOKEN=
